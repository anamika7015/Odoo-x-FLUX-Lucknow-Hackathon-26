NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/brightloop
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brightloop Software <no-reply@example.com>
REDIS_URL=redis://127.0.0.1:6379
APP_TIMEZONE=Asia/Kolkata
# Optional demo login accounts. Configure both email and password per role, then run `cd server && npm run seed:demo`.
# Use unique, strong values. Demo login stays unavailable until the accounts are seeded.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
